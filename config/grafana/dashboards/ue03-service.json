{
  "uid": "ue03-service",
  "title": "UE03 · Santé du service",
  "description": "Service local et charge synthétique ; métriques HTTP RED.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Europe/Paris",
  "tags": [
    "UE03"
