          },
          "expr": "((sum by (build) (count_over_time({dataset=\"$dataset\",event=\"perf_spike\"} | json cause=\"cause\", build=\"build\", width=\"width\", bloom=\"bloom\" | cause!=\"invalid\" | width >= 2560 | bloom=\"true\" | __error__=\"\" | cause=\"overlay\" [$__range]))) or ((sum by (build) (count_over_time({dataset=\"$dataset\",event=\"perf_spike\"} | json cause=\"cause\", build=\"build\", width=\"width\", bloom=\"bloom\" | cause!=\"invalid\" | width >= 2560 | bloom=\"true\" | __error__=\"\" [$__range]))) * 0)) / (sum by (build) (count_over_time({dataset=\"$dataset\",event=\"perf_spike\"} | json cause=\"cause\", build=\"build\", width=\"width\", bloom=\"bloom\" | cause!=\"invalid\" | width >= 2560 | bloom=\"true\" | __error__=\"\" [$__range])))",
